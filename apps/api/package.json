{
  "name": "@kora/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "openapi": "node dist/openapi-cli.js",
    "md:feed": "tsx src/market-data/feed-cli.ts",
    "load:ws": "node load/ws-fanout.mjs",
    "control-matrix": "tsx src/governance/control-matrix-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@kora/domain": "workspace:*",
    "@kora/market-data": "workspace:*",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@kora/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.8",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.1",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.8",
    "vitest": "^3.2.4"
  }
}
