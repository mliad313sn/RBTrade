# KORA environment. Copy to .env (scripts/dev-db.sh does this for you on first run).
# Every secret comes from env. The values below are DEV-ONLY defaults for a local, isolated cluster.

# ---- Runtime ---------------------------------------------------------------
# dev | test | staging | production
KORA_ENV=dev
NODE_ENV=development
# LIVE trading is disabled by design. Only the Sponsor may change this, and goal 09 controls must operate.
LIVE_TRADING_ENABLED=false

# ---- Native dev services (scripts/dev-db.sh) --------------------------------
PG_BIN=/usr/lib/postgresql/16/bin
KORA_PG_PORT=55432
KORA_PG_SUPERUSER_PASSWORD=postgres_dev_only
KORA_REDIS_PORT=56379

# ---- Database roles (created by scripts/db-bootstrap.sh / infra/postgres/init) -
# kora_owner owns the schema and runs migrations.
KORA_DB_OWNER_PASSWORD=kora_owner_dev_only
# kora_app is the runtime role; INSERT/SELECT only on audit_events.
KORA_DB_APP_PASSWORD=kora_app_dev_only
# kora_audit_reader is read-only (auditors, goal 09).
KORA_DB_AUDIT_READER_PASSWORD=kora_reader_dev_only

DATABASE_URL=postgres://kora_app:kora_app_dev_only@127.0.0.1:55432/kora
DATABASE_URL_MIGRATE=postgres://kora_owner:kora_owner_dev_only@127.0.0.1:55432/kora
# Integration tests use a separate database. Superuser URL is only used by the tamper test.
DATABASE_URL_TEST=postgres://kora_app:kora_app_dev_only@127.0.0.1:55432/kora_test
DATABASE_URL_MIGRATE_TEST=postgres://kora_owner:kora_owner_dev_only@127.0.0.1:55432/kora_test

# IRTC R1-11: the dev Redis requires this password (scripts/dev-db.sh); clients read it from REDIS_URL.
# Staging and production refuse a REDIS_URL without a password (and without TLS: rediss://).
KORA_REDIS_PASSWORD=kora_redis_dev_only
REDIS_URL=redis://:kora_redis_dev_only@127.0.0.1:56379

# ---- API ---------------------------------------------------------------------
API_PORT=4000
# Used by Next.js rewrites and middleware to reach the API server-side.
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# Goal 10 (B-015): number of proxies we operate in front of the web server (e.g. 1 behind one
# ingress that appends the peer address to X-Forwarded-For). 0 = the web server is the edge: the
# header is ignored and the real TCP peer is used, stamped by apps/web/peer-address.cjs, which
# `pnpm dev`, `pnpm start`, Playwright and the Docker image preload (IRTC R1-05). In staging and
# production the proxy answers 503 when neither is in place.
KORA_TRUSTED_PROXY_HOPS=0
# Requests per minute per client on every api route (default 600); order, auth, AI and research routes have their own limits.
KORA_API_RATE_LIMIT=600
# Goal 10 (B-015): upstream proxies the api trusts for X-Forwarded-For (Express syntax), e.g. 'loopback, 10.0.0.0/8'.
KORA_API_TRUST_PROXY=loopback

# ---- Identity (ADR 0101) --------------------------------------------------------
# dev = built-in OIDC-compatible dev IdP (refuses NODE_ENV=production) | keycloak
AUTH_PROVIDER=dev
KORA_JWT_ISSUER=http://localhost:4000/auth
KORA_JWT_AUDIENCE=kora-api
# ES256 private JWK (JSON) for the dev IdP. Empty = ephemeral key per process (dev only).
KORA_DEV_IDP_PRIVATE_JWK=
# 32-byte base64 key for AES-256-GCM encryption of TOTP secrets. Empty = ephemeral (dev only).
KORA_MFA_ENC_KEY=
# scrypt cost (power of two). 131072 in prod-like envs; tests use 16384 for speed.
KORA_SCRYPT_N=131072
# Sign-in routes (IRTC R1-05): requests per minute per client IP + account (e-mail or token subject)...
KORA_AUTH_RATE_LIMIT=20
# ...and per client IP over all accounts (empty = 5 x KORA_AUTH_RATE_LIMIT).
KORA_AUTH_IP_RATE_LIMIT=
# IRTC R1-11: new accounts per client IP per hour, and appropriateness attempts per client IP per day
# across all accounts (stops a sybil walking the answer key).
KORA_SIGNUP_RATE_LIMIT_PER_HOUR=10
KORA_APPROPRIATENESS_IP_LIMIT_PER_DAY=10
# IRTC R1-08: whole-chain audit verifications per client per minute.
KORA_AUDIT_VERIFY_RATE_LIMIT=10
# IRTC R1-11: the dev IdP is refused in staging unless this is true (never in production).
KORA_ALLOW_DEV_IDP=false
KORA_ACCESS_TOKEN_TTL_SECONDS=1800

# Keycloak (AUTH_PROVIDER=keycloak and docker compose)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=kora
KEYCLOAK_CLIENT_ID=kora-web
KEYCLOAK_CLIENT_SECRET=change-me-dev-only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only

# ---- Observability ------------------------------------------------------------
# Empty disables the OTLP exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Goal 10: also write finished spans as JSON lines to this file (tests, chaos and load drills).
KORA_OTEL_FILE=
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=grafana_dev_only

# ---- Other services -------------------------------------------------------------
QUANT_PORT=8000
# Where the api reaches the quant service (default http://127.0.0.1:$QUANT_PORT), request timeout,
# and simulation runs per minute per client on /sim/* (goal 05).
QUANT_URL=
QUANT_TIMEOUT_MS=20000
KORA_SIM_RATE_LIMIT=60
BOT_RUNNER_HEALTH_PORT=4100

# ---- AI (goal 07). Never hard-code a model ID. -------------------------------------
# Model id and key come from env / the secret store only. With KORA_AI_MODEL unset the copilot
# answers "Copilot unavailable" (fail closed); the strip's data (bias, calibration) still works.
KORA_AI_MODEL=
ANTHROPIC_API_KEY=
# anthropic (default) | scripted | replay. scripted/replay are test doubles, refused outside dev/test.
KORA_AI_PROVIDER=anthropic
# scripted persona: reference | adversarial (security tests).
# KORA_AI_SCRIPT_PERSONA=reference
# KORA_AI_REPLAY_DIR=            # replay cassettes;  KORA_AI_RECORD_DIR= records live turns
# adaptive (default) | omit (for models without adaptive thinking); effort: low|medium|high|xhigh|max
KORA_AI_THINKING=adaptive
# KORA_AI_EFFORT=
KORA_AI_MAX_TOKENS=4096
KORA_AI_MAX_TOOL_ROUNDS=6
# Budgets (tokens per UTC day) and per-user rate limit; exceeding one returns a friendly message.
KORA_AI_USER_DAILY_TOKENS=200000
KORA_AI_ORG_DAILY_TOKENS=5000000
KORA_AI_RATE_PER_MIN=20
KORA_AI_ORG_ID=default
# Response cache for identical grounded requests (seconds; 0 disables).
KORA_AI_CACHE_TTL_S=300
# Minimum resolved predictions per calibration bin before a confidence figure is shown.
KORA_AI_CALIBRATION_MIN_N=30
# Risk % of equity used to size "Draft to ticket" (the user reviews it in the ticket).
KORA_AI_DRAFT_RISK_PCT=0.5
# USD per million tokens for the cost metric only (unset = 0; the repo holds no model prices).
# KORA_AI_PRICE_INPUT_USD_PER_MTOK=
# KORA_AI_PRICE_OUTPUT_USD_PER_MTOK=
# KORA_AI_PRICE_CACHE_READ_USD_PER_MTOK=
# KORA_AI_PRICE_CACHE_WRITE_USD_PER_MTOK=
# Salt for the pseudonymous user reference sent to the model (set a secret value in deployments).
# KORA_AI_PSEUDONYM_SALT=
# Bearer token Prometheus must send to GET /metrics (required outside dev).
# KORA_METRICS_TOKEN=

# ---- End-to-end tests (Playwright) --------------------------------------------------
DATABASE_URL_E2E=postgres://kora_app:kora_app_dev_only@127.0.0.1:55432/kora_e2e
DATABASE_URL_MIGRATE_E2E=postgres://kora_owner:kora_owner_dev_only@127.0.0.1:55432/kora_e2e
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# ---- Market data (goal 02, ADR 0002) ---------------------------------------------
# inprocess = the api runs the SIMULATED feed; off = run `pnpm --filter @kora/api md:feed` separately.
KORA_MD_FEED=inprocess
KORA_MD_SEED=kora-sim
# Optional comma list to restrict the simulated universe (default: every active registry instrument).
KORA_MD_SYMBOLS=
# SIMULATED history backfill on first start (days of candles before the live start).
KORA_MD_BACKFILL=true
KORA_MD_HISTORY_DAYS=10
# Pause simulated quotes outside venue sessions. Unset = on outside dev/test (B-208); this dev file keeps it
# off so the terminal is alive at weekends.
KORA_MD_RESPECT_SESSIONS=false
# UI conflation per channel (token bucket) and per-client write coalescing window (0 = end of loop turn).
KORA_MD_CONFLATE_PER_SEC=10
KORA_MD_CONFLATE_BURST=2
KORA_MD_WS_FLUSH_MS=0
# Extra allowed WebSocket Origins (WEB_ORIGIN is always allowed).
KORA_MD_WS_ORIGINS=
# Real-provider stubs (decoders only; live transports are not implemented and refuse to connect).
KORA_MD_ADAPTER_FXCFD=false
KORA_MD_ADAPTER_CRYPTO_TESTNET=false
KORA_MD_ADAPTER_EQUITIES=false

# ---- Trading core (goal 03, ADR 0003) — PAPER only; every value is a SIMULATED placeholder --------
# Paper account opened on first use: starting cash and base (account) currency.
KORA_PAPER_STARTING_CASH=100000
KORA_PAPER_BASE_CURRENCY=USD
# Platform risk limits (base currency). Accounts may tighten them, never loosen (OQ-R3).
KORA_RISK_MAX_ORDER_NOTIONAL=1000000
KORA_RISK_MAX_POSITION_NOTIONAL=2000000
KORA_RISK_MAX_LEVERAGE=30
KORA_RISK_DAILY_LOSS_LIMIT=5000
KORA_RISK_WEEKLY_LOSS_LIMIT=10000
KORA_RISK_MAX_ORDERS_PER_MINUTE=60
# Order endpoints per client per minute (throttler).
KORA_ORDER_RATE_LIMIT=600
# Fill safety: feed status older than this is not ok.
KORA_TRADING_STATUS_MAX_AGE_MS=5000
# Matching loop sweep (held orders, expiries, roll) and the daily roll hour (UTC) for swaps.
KORA_ENGINE_ENABLED=true
KORA_ENGINE_SWEEP_MS=1000
KORA_TRADING_ROLL_UTC_HOUR=21
# Reconciliation interval (0 = only on demand via POST /reconciliation/run).
KORA_RECONCILIATION_INTERVAL_MS=60000
# Margin call / close-out (IRTC R2-20, OQ-B3: decided by the Product Owner under delegated Sponsor
# authority, PAPER only). Margin level = equity / margin used, in %. Check interval in ms (0 = every sweep).
KORA_MARGIN_CALL_LEVEL_PCT=100
KORA_MARGIN_CLOSEOUT_LEVEL_PCT=50
KORA_MARGIN_CHECK_MS=5000

# ---- Appropriateness assessment (B-018) — questionnaire data in apps/api/src/appropriateness ------
# Optional overrides of the reviewed questionnaire data (empty = use the data file).
KORA_APPROPRIATENESS_PASS_MARK_PCT=
KORA_APPROPRIATENESS_COOLDOWN_MINUTES=

# ---- Pro terminal (goal 04, ADR 0004) ----------------------------------------------------------
# AI strip under the chart: off | placeholder (explains the copilot is not available) | on (goal 07 copilot strip).
KORA_AI_STRIP=on
# Server-side price / RSI alert evaluation.
KORA_ALERTS_ENABLED=true
KORA_ALERTS_EVAL_MS=1000
# Test aid only: symbols the engine treats as in session (e.g. EURUSD for weekend e2e runs).
# Refused unless KORA_ENV is dev or test. Leave empty.
KORA_TRADING_SESSION_OVERRIDE=
# e2e isolation (optional): ports and Redis prefix for a second Playwright stack on the same host.
# E2E_API_PORT=4010
# E2E_WEB_PORT=3010
# E2E_QUANT_PORT=8010
# E2E_MD_REDIS_PREFIX=kora:e2e:md:
# ---- Robot trader (goal 06, ADR 0006) — PAPER only; thresholds are SIMULATED placeholders ---------
# Bot runner ↔ api shared secret for /internal/robots/* (≥ 32 chars; generated for dev by scripts/dev-db.sh).
# Empty = robots disabled (the runner only heartbeats and the internal routes refuse).
KORA_SERVICE_TOKEN=
# Runner heartbeat (the api pauses a robot after 3 missed beats) and the api's supervision interval.
KORA_ROBOT_HEARTBEAT_MS=5000
KORA_ROBOT_SUPERVISOR_MS=1000
# Runner: robot re-sync interval, daily tracking-error job (BullMQ cron, UTC; empty disables), api timeout.
KORA_BOT_RUNNER_SYNC_MS=5000
KORA_BOT_RUNNER_TRACKING_CRON=5 0 * * *
KORA_BOT_RUNNER_TIMEOUT_MS=15000
# Bar-close evaluations in parallel per runner (default 16, max 64).
KORA_BOT_RUNNER_CONCURRENCY=16
# Research: optimisation hard cap (never above 1,000), bars per symbol, quant timeout, runs per minute.
KORA_BT_MAX_COMBOS=200
KORA_BT_MAX_BARS=20000
KORA_BT_TIMEOUT_MS=120000
KORA_BT_RATE_LIMIT=30
# Promote-to-LIVE checklist thresholds (OQ-R8). Promotion stays blocked while LIVE_TRADING_ENABLED=false.
KORA_PROMOTE_MIN_OOS_SHARPE=0.8
KORA_PROMOTE_MIN_OOS_TRADES=100
# IRTC R3-02 (OQ-R8a, decided by the Product Owner): holdout length and deflated Sharpe of the evidence run.
KORA_PROMOTE_MIN_OOS_DAYS=90
KORA_PROMOTE_MIN_HOLDOUT_DSR=0.95
KORA_PROMOTE_MIN_PAPER_DAYS=30
KORA_PROMOTE_MAX_TE_PCT=1
# e2e: bot runner health port, market-data Redis namespace and the test-only service token.
E2E_BOT_RUNNER_PORT=4110
E2E_MD_REDIS_PREFIX=kora:e2e:md:
# ---- Market intelligence (goal 07B, ADR 0007B) — all data SIMULATED ------------------------------
# Bar-close scans of the universe (empty = on in dev, off in test) and how often to check for a new bar.
KORA_INTEL_SCAN=
KORA_INTEL_SCAN_CHECK_MS=60000
# Scan timeframe, bars per instrument, forecast horizons (label:bars) and walk-forward minimum training rows.
KORA_INTEL_TIMEFRAME=1h
KORA_INTEL_BARS=1000
KORA_INTEL_HORIZONS=1d:24,1w:120,1m:480
KORA_INTEL_MIN_TRAIN=200
# Look-ahead guard checkpoints per scan on the api path, and the quant timeout for a scan.
# At least 8, spread after the warm-up plus random points, compared by wall-clock time (IRTC R3-05).
KORA_INTEL_GUARD_CHECKPOINTS=8
KORA_INTEL_TIMEOUT_MS=120000
# News pipeline on a timer (empty = on in dev, off in test); scoring uses the goal 07 gateway (KORA_AI_MODEL).
KORA_INTEL_NEWS=
KORA_INTEL_NEWS_INTERVAL_MS=900000
# Goal 06 ai_regime condition: model (scanner regime filter, point-in-time) | off (not_available).
KORA_AI_REGIME=model
# Flagged news provider stubs (OQ-M4): even when "true" the live transport refuses (no licence).
KORA_NEWS_ADAPTER_AMERICAS=
KORA_NEWS_ADAPTER_EMEA=
KORA_NEWS_ADAPTER_APAC=

# ---- Novice view (goal 08, ADR 0008) — PAPER only; every value is a SIMULATED placeholder ---------
# Regulatory retail-loss figure for the risk warning (OQ-R1). Since goal 09 the value lives in the disclosures
# registry (four-eyes publication); this env var is a dev/test-only override. Empty = "[XX]" stays visible.
KORA_DISCLOSURE_RETAIL_LOSS_PCT=
# Guarded users (novice-only or in the Novice view): a loosened limit waits this long; tightening is immediate.
KORA_NOVICE_LOOSEN_DELAY_HOURS=24
# Cooling-off until the next UTC day after N losing trades in a day or a day loss of this % (OQ-R5).
KORA_NOVICE_COOLOFF_LOSING_TRADES=3
KORA_NOVICE_COOLOFF_DAILY_LOSS_PCT=5
# Most a novice may borrow once the knowledge check is passed and the 24 h wait is over (OQ-R3). 1 = never.
KORA_NOVICE_MAX_LEVERAGE=2
# Optional platform monthly loss limit (empty = none; accounts set their own).
KORA_RISK_MONTHLY_LOSS_LIMIT=
# Suggested loss limits at onboarding, in % of the practice balance.
KORA_NOVICE_SUGGESTED_DAILY_LOSS_PCT=1.5
KORA_NOVICE_SUGGESTED_MONTHLY_LOSS_PCT=6
# Auto-invest (template robots): smallest and largest amount per robot, in % of the balance.
KORA_NOVICE_AUTOINVEST_MIN_PCT=1
KORA_NOVICE_AUTOINVEST_MAX_PCT=25
# Knowledge check pass mark / cool-down overrides (defaults 80 % = 4/5 and 60 min from the data file).
# KORA_KNOWLEDGE_CHECK_PASS_MARK_PCT=
# KORA_KNOWLEDGE_CHECK_COOLDOWN_MINUTES=
# "Explain this to me" (goal 07 novice copilot in goal 08 screens): on | off (code default off). Needs KORA_AI_MODEL, else it says "Copilot unavailable".
KORA_EXPLAIN_THIS=on

# ---- Risk, compliance and governance (goal 09, ADR 0009) — operating choices, not regulatory values ----
# Kill-switch resume policy: firm (a halt set by the firm needs a second person) | all (every resume, intended for LIVE).
KORA_FOUR_EYES_RESUME=firm
# Pending four-eyes requests expire after this many hours.
KORA_FOUR_EYES_TTL_HOURS=72
# Risk console thresholds: robots "near auto-pause" and accounts "near limit" at this % of a limit.
KORA_RISK_NEAR_PAUSE_PCT=70
KORA_RISK_NEAR_LIMIT_PCT=80
# Signed audit anchors (B-007): ES256 private JWK (required outside dev/test), WORM directory, job interval (0 = off; 86400000 daily).
KORA_AUDIT_ANCHOR_JWK=
KORA_AUDIT_ANCHOR_DIR=
KORA_AUDIT_ANCHOR_INTERVAL_MS=0
# Deployment jurisdiction whose disclosures are served (GLOBAL until OQ-R2 is answered).
KORA_JURISDICTION=GLOBAL
# Release record (control KC-11): build SHA and deployment approval reference, set by the release pipeline.
KORA_BUILD_SHA=
KORA_RELEASE_APPROVAL_REF=
KORA_RELEASE_RECORD=true
# LISTEN/NOTIFY relay of alerts to the risk console WS channel risk:alerts.
KORA_ALERT_RELAY=true
# Retention periods per record class in days (OQ-R4); unset = placeholder, retain. e.g. KORA_RETENTION_ORDERS_DAYS=
# Suitability band thresholds on the score % (SIMULATED placeholders, OQ-C2).
KORA_SUITABILITY_BANDS=34,67
# WebSocket quotas (B-203): open sockets per user and per remote IP.
KORA_MD_WS_MAX_CONN_PER_USER=20
KORA_MD_WS_MAX_CONN_PER_IP=200
# Outside dev/test the api refuses a DATABASE_URL without sslmode=require|verify-full and a redis:// REDIS_URL
# (use rediss://). KORA_ALLOW_INSECURE_TRANSPORT=true only for a local compose stack.
KORA_ALLOW_INSECURE_TRANSPORT=
