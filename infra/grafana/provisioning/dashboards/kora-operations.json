{
  "title": "KORA · Operations (feed, orders, fills, robots, kill switch)",
  "uid": "kora-operations",
  "description": "Goal 10: operational health of the PAPER platform. Every panel links to an SLO in docs/runbooks/slos.md; alerts in infra/prometheus/alerts.yml link to the runbooks. SIMULATED environment.",
  "tags": [
    "kora",
    "goal-10"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
