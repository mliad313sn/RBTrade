{
  "realm": "kora",
  "enabled": true,
  "displayName": "KORA",
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "defaultRoles": [
    "novice"
  ],
  "roles": {
    "realm": [
      {
        "name": "mfa_required",
        "description": "Marker role: members must pass TOTP (conditional OTP flow)."
      },
      {
        "name": "novice",
        "description": "Simple view, guard-railed (goal 08)."
      },
      {
        "name": "trader",
        "description": "Pro terminal. Requires TOTP.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "quant",
        "description": "Strategy builder and research. Requires TOTP.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "risk_officer",
        "description": "Second line of defence. Requires TOTP.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "admin",
        "description": "Administration. Requires TOTP.",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "kora-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "kora-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "kora-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles (realm_access.roles)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "kora-web",
      "name": "KORA web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${WEB_ORIGIN}/api/auth/oidc/callback"
      ],
      "webOrigins": [
        "${WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN}/login"
      },
      "defaultClientScopes": [
        "kora-api-audience",
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "kora-api",
      "name": "KORA API (audience only)",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "browserFlow": "kora browser",
  "authenticationFlows": [
    {
      "alias": "kora browser",
      "description": "Browser login with TOTP required for trader, quant, risk_officer and admin (via mfa_required composite).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "kora browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "kora browser forms",
      "description": "Username/password then conditional OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "kora conditional otp",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "kora conditional otp",
      "description": "OTP when the user has the mfa_required role",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "kora mfa role",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "kora mfa role",
      "config": {
        "condUserRole": "mfa_required",
        "negate": "false"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    }
  ],
  "attributes": {
    "frontendUrl": ""
  }
}
