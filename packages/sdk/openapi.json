{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness + dependency status (db, redis, keycloak). 503 when db or redis is down.",
        "tags": [
          "health"
        ]
      }
    },
    "/kill-switch": {
      "post": {
        "operationId": "KillSwitchController_trigger",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "enum": [
                      "robots",
                      "robots_cancel",
                      "robots_cancel_flatten"
                    ]
                  },
                  "source": {
                    "default": "ui_button",
                    "type": "string",
                    "enum": [
                      "ui_button",
                      "hotkey",
                      "rest_fallback"
                    ]
                  }
                },
                "required": [
                  "scope"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": ""
          }
        },
        "summary": "Request a kill switch with one of three scopes. Always audited.",
        "tags": [
          "kill-switch"
        ]
      }
    },
    "/robots/builder": {
      "get": {
        "operationId": "RobotsController_builder",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Strategy builder metadata (stub until goal 06). Trader, quant or admin only.",
        "tags": [
          "robots"
        ]
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "AdminController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/users/{id}/roles": {
      "put": {
        "operationId": "AdminController_setRoles",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roles": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "novice",
                        "trader",
                        "quant",
                        "risk_officer",
                        "admin"
                      ]
                    }
                  }
                },
                "required": [
                  "roles"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Replace a user's roles (audited). Users with non-novice roles must enrol MFA at next login.",
        "tags": [
          "admin"
        ]
      }
    },
    "/audit": {
      "get": {
        "operationId": "AuditController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "beforeId",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "ISO-8601, exclusive",
            "schema": {}
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "ISO-8601, inclusive",
            "schema": {}
          },
          {
            "name": "action",
            "required": false,
            "in": "query",
            "description": "exact, or prefix with .* (e.g. kill_switch.*)",
            "schema": {}
          },
          {
            "name": "entityId",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "entity",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "actorType",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "user",
                "robot",
                "ai",
                "system"
              ],
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "required": false,
            "in": "query",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List audit events (newest first). Non-privileged users see their own events.",
        "tags": [
          "audit"
        ]
      }
    },
    "/audit/verify": {
      "get": {
        "operationId": "AuditController_verify",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Recompute the hash chain. Returns valid:false with the first broken id on tamper.",
        "tags": [
          "audit"
        ]
      }
    },
    "/auth/.well-known/openid-configuration": {
      "get": {
        "operationId": "AuthController_discovery",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "OIDC discovery (dev IdP subset)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/jwks.json": {
      "get": {
        "operationId": "AuthController_jwks",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Public signing keys of the dev IdP",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "operationId": "AuthController_signup",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "accountType": {
                    "default": "novice",
                    "type": "string",
                    "enum": [
                      "novice",
                      "trader"
                    ]
                  }
                },
                "required": [
                  "email",
                  "password",
                  "displayName"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Create an account (novice or trader; PAPER only). Trader requires MFA enrolment at first login.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Password step. Returns ok, mfa_required or mfa_enrollment_required.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/mfa/enroll": {
      "post": {
        "operationId": "AuthController_enroll",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mfaToken": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "mfaToken"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Start TOTP enrolment. Returns the otpauth URI and base32 secret.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/mfa/verify": {
      "post": {
        "operationId": "AuthController_verify",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mfaToken": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 4096
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "mfaToken",
                  "code"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Verify a TOTP code (completes enrolment on first use) and issue the session.",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Clear the session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Current user, roles, preferences and server-side capabilities",
        "tags": [
          "me"
        ]
      }
    },
    "/me/preferences": {
      "get": {
        "operationId": "MeController_getPreferences",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "me"
        ]
      },
      "put": {
        "operationId": "MeController_updatePreferences",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "viewMode": {
                    "type": "string",
                    "enum": [
                      "pro",
                      "novice"
                    ]
                  },
                  "theme": {
                    "type": "string",
                    "enum": [
                      "system",
                      "pro-dark",
                      "novice-light"
                    ]
                  },
                  "colourConvention": {
                    "type": "string",
                    "enum": [
                      "blue_orange",
                      "green_red",
                      "red_up_asia"
                    ]
                  },
                  "hotkeys": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Update view mode, theme, colour convention or hotkeys (audited)",
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "KORA API",
    "description": "KORA platform API (PAPER only). Money and prices are decimal strings.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kora_at"
      }
    },
    "schemas": {}
  }
}
