          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "enum": [
                      "robots",
                      "robots_cancel",
                      "robots_cancel_flatten"
                    ]
                  },
                  "source": {
                    "default": "ui_button",
                    "type": "string",
                    "enum": [
                      "ui_button",
                      "hotkey",
                      "rest_fallback"
                    ]
                  }
                },
                "required": [
                  "scope"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": ""
          }
        },
        "summary": "Request a kill switch with one of three scopes. Always audited.",
        "tags": [
          "kill-switch"
        ]
      }
    },
